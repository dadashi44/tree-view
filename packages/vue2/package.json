{
  "name": "@bigplay/tree-view-vue2",
  "version": "0.3.1",
  "description": "Компонент дерева и турнирных сеток для Vue 2.6 / 2.7",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "keywords": [
    "vue",
    "vue2",
    "tree",
    "bracket",
    "tournament",
    "diagram"
  ],
  "scripts": {
    "build": "vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@bigplay/tree-view-core": "^0.3.1"
  },
  "peerDependencies": {
    "vue": "^2.6.0 || ^2.7.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.0",
    "@vue/test-utils": "^1.3.6",
    "happy-dom": "^15.11.7",
    "typescript": "^5.8.3",
    "vite": "^7.1.2",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^3.2.4",
    "vue": "^2.7.16",
    "vue-template-compiler": "^2.7.16"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dadashi44/tree-view.git",
    "directory": "packages/vue2"
  },
  "homepage": "https://github.com/dadashi44/tree-view#readme",
  "bugs": {
    "url": "https://github.com/dadashi44/tree-view/issues"
  },
  "author": "Daniyar Kudaibergenev",
  "publishConfig": {
    "access": "public"
  }
}
