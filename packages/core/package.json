{
  "name": "@bigplay/tree-view-core",
  "version": "0.3.1",
  "description": "Раскладка дерева: чистые функции без привязки к фреймворку",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist",
    "styles.css"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./style.css": "./styles.css"
  },
  "scripts": {
    "build": "vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@types/node": "^20.19.0",
    "happy-dom": "^15.11.7",
    "typescript": "^5.8.3",
    "vite": "^7.1.2",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^3.2.4"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dadashi44/tree-view.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/dadashi44/tree-view#readme",
  "bugs": {
    "url": "https://github.com/dadashi44/tree-view/issues"
  },
  "author": "Daniyar Kudaibergenev",
  "publishConfig": {
    "access": "public"
  }
}
